{
  "mcpServers": {
    "api-liexp-dev-db": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://liexp:liexp-password@localhost:8432/liexp"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "mem0": {
      "type": "http",
      "url": "https://mem0.ascariandrea.it/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "lies-exposed-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.liexp.dev/mcp"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "./_data/certs/liexp.dev.crt"
      }
    }
  }
}
