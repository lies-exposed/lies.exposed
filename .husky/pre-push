#!/bin/sh

docker compose up -d db.liexp.dev

# Build first: knip and lint load vitest/vite configs and imports from
# @liexp/*/lib, which don't exist yet in a fresh checkout or worktree.
# @liexp/backend... is always included because every service's vitest config
# imports @liexp/backend/lib/test/vitest.base-config.js.
pnpm --filter "@liexp/backend..." --filter=...[HEAD^] build && pnpm knip && pnpm --filter=...[HEAD^] lint --quiet && pnpm vitest --changed=HEAD^ && . "./scripts/healthcheck.sh"
