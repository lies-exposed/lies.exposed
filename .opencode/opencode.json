{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bugsink": {
      "type": "local",
      "command": ["npx", "-y", "bugsink-mcp"],
      "environment": {
        "BUGSINK_URL": "https://bugsink.ascariandrea.it",
        "BUGSINK_TOKEN": "{env:BUGSINK_TOKEN}"
      },
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "lies-exposed-local": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://api.liexp.dev/mcp"],
      "environment": {
        "NODE_EXTRA_CA_CERTS": "./_data/certs/liexp.dev.crt"
      },
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "paperclip-*": "allow"
    }
  }
}
