{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bugsink": {
      "type": "local",
      "command": ["npx", "-y", "bugsink-mcp"],
      "environment": {
        "BUGSINK_URL": "https://bugsink.ascariandrea.it",
        "BUGSINK_TOKEN": "{env:BUGSINK_TOKEN}"
      },
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "paperclip-*": "allow"
    }
  }
}
