  "devDependencies": {
    "@liexp/eslint-config": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect": "^3.21.3",
    "eslint": "^10.10.0",
    "fp-ts": "^2.16.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "effect": "^3",
    "fp-ts": "^2"
  },
  "packageManager": "pnpm@11.26.0"
