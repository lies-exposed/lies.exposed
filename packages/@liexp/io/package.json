  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "files": [
    "lib",
    "assets"
  ],
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -b tsconfig.build.json",
